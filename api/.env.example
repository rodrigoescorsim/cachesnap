# Copie para .env e preencha. Variáveis obrigatórias da API Rust (cachesnap-api).

DATABASE_URL=postgresql://user:pass@localhost:5432/cachesnap
REDIS_URL=redis://127.0.0.1:6379
PROBE_SECRET=

# Opcional — porta da API (usa-se PORT ou, se vazio, API_PORT; default 3001).
# Em monorepo com Next no mesmo .env, prefira API_PORT para não afetar `next dev`.
# PORT=3001
API_PORT=3001
APP_URL=http://localhost:3000
API_URL=http://localhost:3001

# Opcional — e-mail / Slack (alertas)
# RESEND_API_KEY=
# Use a verified Resend sender in production, e.g. CacheSnap <noreply@cachesnap.com>.
# ALERT_FROM_EMAIL=CacheSnap <alerts@cachesnap.com>
# SLACK_WEBHOOK_URL=

# --- Probe dispatch (429 / concorrência) — todos opcionais ---
# Máximo de POSTs de probe em voo no processo inteiro (default 64).
# PROBE_DISPATCH_MAX_GLOBAL=64
# Máximo em voo por região (cada worker / lambda_url) — default 3.
# PROBE_DISPATCH_MAX_PER_REGION=3
# Regiões em paralelo por monitor dentro de um dispatch — default 3.
# PROBE_DISPATCH_REGION_PARALLEL=3
# Monitores processados em paralelo por tick de 1s do scheduler — default 16.
# PROBE_SCHEDULER_MAX_MONITORS_PARALLEL=16
# Tentativas HTTP por região em caso de 429 (inclui a 1.ª) — default 5.
# PROBE_DISPATCH_429_MAX_ATTEMPTS=5
# Backoff base em ms (429 sem Retry-After) — default 120.
# PROBE_DISPATCH_429_BASE_MS=120
# Teto do backoff em ms — default 5000.
# PROBE_DISPATCH_429_MAX_MS=5000
# Tempo máximo à espera de um permit do semáforo (s) — default 18.
# PROBE_DISPATCH_ACQUIRE_TIMEOUT_SECS=18
