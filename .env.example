# ─── Database ────────────────────────────────────────────────────────────────
DB_PASSWORD=changeme_local

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_PASSWORD=changeme_local

# ─── Rust API ────────────────────────────────────────────────────────────────
# URL completa usada pelo Rust em dev local (aponta para localhost)
DATABASE_URL=postgresql://cachesnap:changeme_local@localhost:5432/cachesnap
REDIS_URL=redis://:changeme_local@localhost:6379
API_PORT=3001

# Segredo compartilhado entre Lambda probes e a API de ingest
# Gere com: openssl rand -hex 32
PROBE_SECRET=changeme_generate_with_openssl

# Intervalo (segundos) entre ciclos do worker de auditoria de alertas (Cache Hit, SSL, Anycast, Zombie).
# Padrão 900 (15 min).
ALERTS_WORKER_INTERVAL_SECS=900

# ─── Notificações ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxx
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# ─── App ─────────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000

# URL pública da API Rust — recebida pelos Lambda probes para enviar resultados de ingest
# Em dev: exponha com `npx cloudflared tunnel --url http://localhost:3001`
# Em produção: https://api.seudominio.com
API_URL=http://localhost:3001

# ─── Next.js (copie também para .env.local) ──────────────────────────────────
NEXTAUTH_SECRET=changeme_local_nextauth
# Em produção: https://yourdomain.com
NEXTAUTH_URL=http://localhost:3000
# Em produção: https://api.yourdomain.com
NEXT_PUBLIC_API_URL=http://localhost:3001

# ─── Lambda Probe URLs ────────────────────────────────────────────────────────
# As URLs das Lambdas NÃO são variáveis de ambiente.
# Elas são armazenadas na tabela `regions` do banco de dados e populadas
# automaticamente pela migração 016_add_regions_table.sql na primeira subida.
# Para atualizar uma URL (ex.: após recriar uma Lambda), use:
#   UPDATE regions SET lambda_url = 'https://...' WHERE id = 'sa-east';
