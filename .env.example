# ─── Database ────────────────────────────────────────────────────────────────
DB_PASSWORD=changeme_local

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_PASSWORD=changeme_local

# ─── Rust API ────────────────────────────────────────────────────────────────
# URL completa usada pelo Rust em dev local (aponta para localhost)
DATABASE_URL=postgresql://cachesnap:changeme_local@localhost:5432/cachesnap
REDIS_URL=redis://:changeme_local@localhost:6379
API_PORT=3001

# Segredo compartilhado entre Lambda probes e a API de ingest
# Gere com: openssl rand -hex 32
PROBE_SECRET=changeme_generate_with_openssl

# Intervalo (segundos) entre ciclos do worker de auditoria de alertas (Cache Hit, SSL, Anycast, Zombie).
# Padrão 900 (15 min).
ALERTS_WORKER_INTERVAL_SECS=900

# ─── Notificações ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxx
# Use a verified Resend sender in production, e.g. CacheSnap <noreply@cachesnap.com>.
ALERT_FROM_EMAIL=CacheSnap <onboarding@resend.dev>
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# ─── App ─────────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000

# URL pública da API Rust — recebida pelos Lambda probes para enviar resultados de ingest
# Em dev: exponha com `npx cloudflared tunnel --url http://localhost:3001`
# Em produção: https://api.seudominio.com
API_URL=http://localhost:3001

# ─── Next.js (copie também para .env.local) ──────────────────────────────────
NEXTAUTH_SECRET=changeme_local_nextauth
# Em produção: https://yourdomain.com
NEXTAUTH_URL=http://localhost:3000
# Em produção: https://api.yourdomain.com
NEXT_PUBLIC_API_URL=http://localhost:3001

# ─── Dodo Payments ───────────────────────────────────────────────────────────
# Em dev: sk_test_... | Em produção: sk_live_...
DODO_API_KEY=sk_test_...
DODO_WEBHOOK_SECRET=whsec_...
# test_mode em dev, live_mode em produção
DODO_ENV=test_mode

DODO_PRODUCT_ID_PRO=pdt_...
DODO_PRICE_ID_PRO=pdt_...

DODO_PRODUCT_ID_TEAM=pdt_...
DODO_PRICE_ID_TEAM=pdt_...

# ─── Admin Observability ─────────────────────────────────────────────────────
# Para dar acesso à página /admin/observability, execute no banco:
#   UPDATE users SET is_admin_internal = true WHERE email = 'you@example.com';

# Webhooks internos por domínio de incidente (podem apontar para o mesmo canal)
OPS_PROBE_ERROR_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
OPS_PIPELINE_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
OPS_ALERTING_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
OPS_DB_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
OPS_PROVIDER_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
OPS_SLO_BREACH_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# ─── Lambda Probe URLs ────────────────────────────────────────────────────────
# As URLs das Lambdas NÃO são variáveis de ambiente.
# Elas são armazenadas na tabela `regions` do banco de dados e populadas
# automaticamente pela migração 016_add_regions_table.sql na primeira subida.
# Para atualizar uma URL (ex.: após recriar uma Lambda), use:
#   UPDATE regions SET lambda_url = 'https://...' WHERE id = 'sa-east';
